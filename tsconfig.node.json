{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,

    // Ver el comentario en tsconfig.app.json — mismo problema de @types
    // duplicado al correr desde un git worktree.
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["vite.config.ts"]
}
