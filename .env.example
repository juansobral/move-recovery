# Plantilla de variables de entorno.
# Copiá este archivo como .env para desarrollo local (.env está en .gitignore).
# En producción se configuran en Vercel → Settings → Environment Variables.
# Un solo .env en la raíz sirve tanto al front (Vite) como al backend (server/).
# Ver DEPLOY.md para el paso a paso de dónde sacar cada valor.

# Neon Postgres — connection string "pooled"
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secreto para firmar los JWT de sesión de /admin. Usá algo largo y aleatorio.
JWT_SECRET=

# Solo se usan para crear/actualizar la cuenta admin con:
#   npm run seed:admin --workspace=server
# No hace falta que queden seteadas en producción después de correr el script.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Brevo → Settings → SMTP & API → API keys (empieza con xkeysib-)
BREVO_API_KEY=

# Remitente: tiene que estar verificado en Brevo
MAIL_FROM=movesc.performance@gmail.com

# Casilla que recibe el aviso de nueva reserva
MAIL_ADMIN=movesc.performance@gmail.com

# URL pública del sitio, sin barra al final (para los links de los emails)
SITE_URL=https://move-recovery.vercel.app

# Google OAuth — Client ID de un "OAuth 2.0 Client ID" tipo Web application
# en Google Cloud Console. El mismo valor va acá y en VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Secreto para firmar los JWT de sesión de clientes (separado del JWT_SECRET
# de admin a propósito — los dos tipos de token nunca deben ser intercambiables).
USER_JWT_SECRET=

# Mismo valor que GOOGLE_CLIENT_ID, expuesto al front (los Client ID de Google
# no son secretos, están pensados para ir en código de cliente).
VITE_GOOGLE_CLIENT_ID=

# MercadoPago — Access Token de tu cuenta (Test o Producción) en
# https://www.mercadopago.com.uy/developers/panel/app
MP_ACCESS_TOKEN=

# Secreto de firma de webhooks — Tu app en el panel de MercadoPago →
# Webhooks → "Firma secreta" (se genera al configurar la URL de notificación).
MP_WEBHOOK_SECRET=

# Secreto propio para firmar el external_reference que viaja por MercadoPago
# (separado de JWT_SECRET/USER_JWT_SECRET a propósito, mismo criterio que los
# otros dos: un secreto por propósito).
CHECKOUT_REFERENCE_SECRET=
