# Plantilla de variables de entorno.
# Copiá este archivo como .env para desarrollo local (.env está en .gitignore).
# En producción se configuran en Vercel → Settings → Environment Variables.
# Ver DEPLOY.md para el paso a paso de dónde sacar cada valor.

# Neon Postgres — connection string "pooled"
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clave para entrar a /admin. Usá algo largo y aleatorio.
ADMIN_KEY=

# Brevo → Settings → SMTP & API → API keys (empieza con xkeysib-)
BREVO_API_KEY=

# Remitente: tiene que estar verificado en Brevo
MAIL_FROM=movesc.performance@gmail.com

# Casilla que recibe el aviso de nueva reserva
MAIL_ADMIN=movesc.performance@gmail.com

# URL pública del sitio, sin barra al final (para los links de los emails)
SITE_URL=https://move-recovery.vercel.app
